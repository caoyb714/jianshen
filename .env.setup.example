# 开通用的一次性凭据。复制为 .env.setup.local 后填写，文件已被 .gitignore 覆盖。
# 只有 SUPABASE_ACCESS_TOKEN 是必须的：Account → Access Tokens → Generate new token。
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxx
# 数据库密码，脚本用它创建项目，至少 12 位。自己定，别用常见密码。
SUPABASE_DB_PASSWORD=
# 区域，选定后不能改。ap-southeast-1 新加坡，ap-northeast-1 东京。
SUPABASE_REGION=ap-southeast-1
# 组织 ID，留空则用令牌下的第一个组织。
SUPABASE_ORG_ID=
# 两个账号，留空则自动生成 herfit.a@herfit.local 与随机密码。
HERFIT_USER_A_EMAIL=
HERFIT_USER_A_PASSWORD=
HERFIT_USER_B_EMAIL=
HERFIT_USER_B_PASSWORD=
